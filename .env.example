# Copy to .env.local (never commit real values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by sync + scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Linear personal API key (Settings > API). Server-only.
LINEAR_API_KEY=
# Linear webhook signing secret (webhook detail page). Server-only.
LINEAR_WEBHOOK_SECRET=
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Slug of the workspace the sync writes into.
PACE_WORKSPACE_SLUG=sysvit
